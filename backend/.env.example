# =========================================================
# tracker_system - Express mock of betterdays_tracker backend
# Copy this file to .env and adjust as needed.
#
# !! IMPORTANT: NO REAL BACKEND SECRETS HERE !!
# The mock uses its OWN fake signing secret. It is only good
# for signing the demo JWT tokens this mock issues/accepts.
# Never copy the production JWT_SECRET_KEY or any cert here.
# =========================================================

# Port the mock listens on (matches the real backend's 8000).
PORT=8000

# Mock-only JWT signing secret. Change to anything you like.
# Tokens must be minted with the same value. This is FAKE.
MOCK_JWT_SECRET=change-me-mock-dev-secret

# Optional telemetry simulation (nudges device positions + appends
# occasional messages every few seconds). Set to 1 to enable.
MOCK_TELEMETRY=0

# Directory where uploads are saved and served from.
UPLOAD_FOLDER=./uploads